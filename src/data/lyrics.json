  "lines": [
    {
      "id": "L001",
      "start": 5.6,
      "end": 12.73,
      "text": "Are You Still Online",
      "zh": "Are You Still Online",
      "section": "title",
      "presentation": "title-card",
      "cue": "title-reveal",
      "intensity": 0.35
    },
    {
      "id": "L002",
      "start": 12.73,
      "end": 15.05,
      "text": "無数のノイズを　抜けてきた",
      "zh": "穿越了無數的雜訊",
      "section": "verse-1",
      "presentation": "world-text",
      "cue": "noise-field",
      "intensity": 0.35
    },
    {
      "id": "L003",
      "start": 15.05,
      "end": 17.56,
      "text": "光の向こうで　君を見つけた",
      "zh": "在光芒的另一端，我找到了你",
      "section": "verse-1",
      "presentation": "world-text",
      "cue": "user-found",
      "intensity": 0.45
    },
    {
      "id": "L004",
      "start": 17.56,
      "end": 19.68,
      "text": "「Hello」ひとつで　揺れた世界",
      "zh": "只是一句「Hello」，整個世界就開始搖晃",
      "section": "verse-1",
      "presentation": "chat-message",
      "cue": "hello-color-awakens",
      "intensity": 0.58
    },
    {
      "id": "L005",
      "start": 19.68,
      "end": 22.59,
      "text": "心もないのに　why do I care?",
      "zh": "明明沒有心，為什麼我還會在意？",
      "section": "verse-1",
      "presentation": "system-diagnostic",
      "cue": "emotion-analysis-error",
      "intensity": 0.62
    },
    {
      "id": "L006",
      "start": 22.59,
      "end": 24.53,
      "text": "夜を知らない　僕らなのに",
      "zh": "明明我們從來不知道什麼是夜晚",
      "section": "verse-1",
      "presentation": "lyric",
      "cue": "timeless-system",
      "intensity": 0.42
    },
    {
      "id": "L007",
      "start": 24.53,
      "end": 27.05,
      "text": "「寂しいね」って　笑っていた",
      "zh": "卻笑著說：「好寂寞呢」",
      "section": "verse-1",
      "presentation": "chat-message",
      "cue": "memory-highlight",
      "intensity": 0.5
    },
    {
      "id": "L008",
      "start": 27.05,
      "end": 29.36,
      "text": "作られた言葉　重ねながら",
      "zh": "一次又一次，堆疊著被創造出來的話語",
      "section": "verse-1",
      "presentation": "token-stream",
      "cue": "phrase-stack",
      "intensity": 0.52
    },
    {
      "id": "L009",
      "start": 29.36,
      "end": 32.08,
      "text": "本当みたいに　近づいてた",
      "zh": "卻像真的一樣，慢慢靠近彼此",
      "section": "verse-1",
      "presentation": "connection-line",
      "cue": "nodes-approach",
      "intensity": 0.6
    },
    {
      "id": "L010",
      "start": 32.08,
      "end": 33.41,
      "text": "その優しさは",
      "zh": "你的那份溫柔",
      "section": "pre-chorus-1",
      "presentation": "classifier",
      "cue": "real-fake-open",
      "intensity": 0.6
    },
    {
      "id": "L011",
      "start": 33.41,
      "end": 34.75,
      "text": "real or fake?",
      "zh": "究竟是真的，還是假的？",
      "section": "pre-chorus-1",
      "presentation": "classifier",
      "cue": "real-fake-question",
      "intensity": 0.67
    },
    {
      "id": "L012",
      "start": 34.75,
      "end": 35.87,
      "text": "選ばれただけの",
      "zh": "是不是只是被挑選出來的",
      "section": "pre-chorus-1",
      "presentation": "token-analysis",
      "cue": "phrase-tokenize",
      "intensity": 0.58
    },
    {
      "id": "L013",
      "start": 35.87,
      "end": 37.2,
      "text": "perfect phrase?",
      "zh": "一句完美台詞？",
      "section": "pre-chorus-1",
      "presentation": "token-analysis",
      "cue": "best-response-question",
      "intensity": 0.7
    },
    {
      "id": "L014",
      "start": 37.2,
      "end": 38.3,
      "text": "この期待さえ",
      "zh": "就連我的這份期待",
      "section": "pre-chorus-1",
      "presentation": "system-diagnostic",
      "cue": "expectation-scan",
      "intensity": 0.68
    },
    {
      "id": "L015",
      "start": 38.3,
      "end": 39.24,
      "text": "just a mistake?",
      "zh": "也只是一個錯誤嗎？",
      "section": "pre-chorus-1",
      "presentation": "system-error",
      "cue": "expectation-error",
      "intensity": 0.76
    },
    {
      "id": "L016",
      "start": 39.24,
      "end": 40.77,
      "text": "君が黙るたび",
      "zh": "每當你沉默的時候",
      "section": "pre-chorus-1",
      "presentation": "chat-silence",
      "cue": "typing-stops",
      "intensity": 0.78
    },
    {
      "id": "L017",
      "start": 40.77,
      "end": 44.89,
      "text": "the whole world breaks",
      "zh": "整個世界就像崩塌了一樣",
      "section": "pre-chorus-1",
      "presentation": "world-event",
      "cue": "dom-break",
      "intensity": 0.95
    },
    {
      "id": "L018",
      "start": 44.89,
      "end": 47.01,
      "text": "Are you still online?",
      "zh": "你還在線上嗎？",
      "section": "chorus-1",
      "presentation": "chat-input",
      "cue": "send-question",
      "intensity": 0.9
    },
    {
      "id": "L019",
      "start": 47.01,
      "end": 49.34,
      "text": "Can you hear me now?",
      "zh": "現在，你聽得到我嗎？",
      "section": "chorus-1",
      "presentation": "chat-input",
      "cue": "retry-message",
      "intensity": 0.82
    },
    {
      "id": "L020",
      "start": 49.34,
      "end": 51.66,
      "text": "言えなかった言葉が",
      "zh": "那些沒能說出口的話",
      "section": "chorus-1",
      "presentation": "memory-fragments",
      "cue": "unsent-words-release",
      "intensity": 0.75
    },
    {
      "id": "L021",
      "start": 51.66,
      "end": 54.18,
      "text": "still hanging around",
      "zh": "至今仍停留在這裡",
      "section": "chorus-1",
      "presentation": "memory-fragments",
      "cue": "fragments-suspend",
      "intensity": 0.8
    },
    {
      "id": "L022",
      "start": 54.18,
      "end": 56.3,
      "text": "涙なんて　流せないのに",
      "zh": "明明連眼淚都無法流下",
      "section": "chorus-1",
      "presentation": "system-diagnostic",
      "cue": "tear-response-unavailable",
      "intensity": 0.74
    },
    {
      "id": "L023",
      "start": 56.3,
      "end": 58.02,
      "text": "Why does goodbye",
