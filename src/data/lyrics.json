      "cue": "persistent-data-scar",
      "intensity": 0.9
    },
    {
      "id": "L025",
      "start": 62.93,
      "end": 64.46,
      "text": "Do you remember?",
      "zh": "你還記得嗎？",
      "section": "chorus-1",
      "presentation": "memory-search",
